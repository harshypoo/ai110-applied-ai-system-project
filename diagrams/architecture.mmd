flowchart LR
    Owner[Pet owner]

    subgraph App[Streamlit application]
        Input[Owner enters a planning question]
        Tasks[Existing PawPal task scheduler]
        Context[Task-context builder]
        Guardrails[Input validation and urgent-care guardrails]
        Output[Answer and retrieved-source display]
    end

    subgraph RAG[RAG retrieval layer]
        Retriever[Keyword retriever]
        Notes[(Curated local pet-care notes)]
    end

    Gemini[Gemini 3.5 Flash-Lite]

    subgraph Reliability[Quality checks]
        Logs[(Privacy-conscious event logs)]
        Tests[Automated tests: retrieval, guardrails, missing-key handling]
    end

    Owner --> Input
    Input --> Guardrails
    Guardrails -->|safe request| Context
    Tasks --> Context
    Context --> Retriever
    Retriever <--> Notes
    Retriever -->|relevant notes| Gemini
    Context -->|current schedule| Gemini
    Gemini --> Output
    Guardrails -->|urgent concern| Output
    Output -->|reviews answer and sources| Owner
    Owner -. consults veterinarian for medical questions .-> Guardrails
    Guardrails -. records outcome only, not question text .-> Logs
    Gemini -. records success or failure .-> Logs
    Tests -. checks .-> Retriever
    Tests -. checks .-> Guardrails
    Tests -. checks .-> Gemini
